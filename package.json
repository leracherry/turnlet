{
  "name": "turnlet-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "browser:harness": "vite --host 127.0.0.1 --port 4173",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run build --workspace turnlet && vitest run",
    "test:browser": "playwright test",
    "test:package": "npm run build --workspace turnlet && node scripts/verify-package.mjs",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.63.0",
    "eslint": "9.39.5",
    "globals": "17.4.0",
    "prettier": "3.9.8",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "vite": "6.4.3",
    "vitest": "4.1.11"
  }
}
