{
  "name": "turnlet",
  "version": "0.1.0",
  "description": "Cooperative array processing for responsive interfaces.",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "license": "MIT",
  "author": "Valeriia Radchenko",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leracherry/turnlet.git",
    "directory": "packages/turnlet"
  },
  "homepage": "https://github.com/leracherry/turnlet#readme",
  "bugs": {
    "url": "https://github.com/leracherry/turnlet/issues"
  },
  "keywords": [
    "chunking",
    "cooperative-scheduling",
    "inp",
    "performance",
    "typescript"
  ],
  "scripts": {
    "prepack": "npm run build",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json && tsc -p tsconfig.browser.json"
  }
}
